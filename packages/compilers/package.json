{
  "name": "@replay/compilers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:e2e": "REPLAY_RUN_COMPILER_E2E=1 vitest run tests/generated-script.e2e.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@replay/ir": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
