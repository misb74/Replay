# Required only when turning a recording into a workflow or using visual run checks.
ANTHROPIC_API_KEY=

# Optional model override.
REPLAY_CLAUDE_MODEL=claude-sonnet-5

# Optional live-tutor model override.
REPLAY_LIVE_MODEL=claude-opus-5

# Optional: "1" lets you talk over the live tutor instead of pausing to
# interrupt it. Experimental until echo cancellation is verified on hardware.
REPLAY_LIVE_FULL_DUPLEX=

# Optional absolute path to a local timestamped-transcript command.
# It receives: --input <audio.m4a> --output-json -
# Apple Silicon development example:
# REPLAY_TRANSCRIBE_COMMAND=/absolute/path/to/Replay/scripts/transcribe-whisper.mjs
REPLAY_TRANSCRIBE_COMMAND=

# Optional absolute-path overrides used by scripts/transcribe-whisper.mjs.
# Its defaults target Homebrew's Apple Silicon ffmpeg and whisper-cpp installs.
REPLAY_FFMPEG_BINARY=
REPLAY_WHISPER_BINARY=
REPLAY_WHISPER_MODEL=

# Optional development override for a separately built capture helper.
REPLAY_CAPTURE_BINARY=
